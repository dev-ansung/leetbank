---
import catalog from "../data/catalog.json";
import "../styles/global.css";

export const prerender = false; // Cloudflare Edge SSR

const { id } = Astro.params;
const problem = !isNaN(Number(id))
  ? catalog.find(p => p.id === Number(id))
  : catalog.find(p => p.slug === id);

if (!problem) {
  return Astro.redirect("/?not_found=" + encodeURIComponent(id || ""));
}
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>#{problem.id} {problem.title} - LeetBank 🏦</title>
    <meta name="description" content={`Problem #${problem.id} ${problem.title} (${problem.difficulty}) - Free LeetCode question with 19 starter languages and 16 reference solutions.`} />
  </head>
  <body class="bg-white dark:bg-[#09090b] text-zinc-900 dark:text-zinc-100 min-h-screen">
    <div class="max-w-4xl mx-auto p-6 flex flex-col gap-6">
      <div class="flex items-center justify-between border-b border-zinc-200 dark:border-zinc-800 pb-4">
        <div class="flex items-center gap-3">
          <a href="/" class="text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition">
            ← Back to All Problems
          </a>
          <span class="text-zinc-300 dark:text-zinc-700">•</span>
          <span class="text-sm font-mono font-bold text-zinc-500">#{problem.id}</span>
          <h1 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">{problem.title}</h1>
          <span class="text-xs px-2 py-0.5 rounded border border-zinc-200 dark:border-zinc-800 font-medium">
            {problem.difficulty}
          </span>
        </div>

        <div class="flex items-center gap-2">
          <a
            href={`https://leetcode.com/problems/${problem.slug}`}
            target="_blank"
            class="text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition px-2.5 py-1 rounded border border-zinc-200 dark:border-zinc-800"
          >
            LeetCode Official ↗
          </a>
        </div>
      </div>

      <div class="bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-6 rounded-xl flex flex-col gap-4">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Problem Summary</h2>
        <p class="text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">
          Detailed problem statement, multi-language starter templates, and verified reference solutions are served from Cloudflare Edge.
        </p>
        <div class="flex items-center gap-2 flex-wrap pt-2">
          {problem.topics.map(t => (
            <span class="text-xs px-2 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
              {t}
            </span>
          ))}
        </div>
      </div>
    </div>
  </body>
</html>
